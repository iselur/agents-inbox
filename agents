#!/usr/bin/env python3
"""agents — an inbox for your Claude Code background agents.

Lists the background jobs in ~/.claude/jobs and remembers which finished
ones you've already read, so the ● marks are always the ones you still
need to look at.

  agents             list jobs, latest finished on top (● = finished, unread)
  agents unread      list only finished jobs you haven't read yet
  agents show ID     print a job's intent, state and full result text
  agents read ID..   mark job(s) as read ('agents read all' = every finished job)
  agents unread ID   mark a job unread again

IDs may be abbreviated to any unique prefix. A job that produces new
output after you marked it read flips back to unread automatically.

Read state is a `.read` marker file inside each job directory — deleting
a job deletes its marker. Marking a job read also prefixes '✓ ' to its
summary line, so Claude Code's own built-in job list shows the mark too.

Respects $CLAUDE_CONFIG_DIR (default ~/.claude) and $NO_COLOR.
"""
import json, sys, glob, os
from datetime import datetime, timezone, timedelta

CONFIG = os.environ.get("CLAUDE_CONFIG_DIR") or os.path.expanduser("~/.claude")
JOBS = os.path.join(CONFIG, "jobs")
RUNNING = {"working", "active", "starting"}
COLOR = sys.stdout.isatty() and not os.environ.get("NO_COLOR")


def c(code, s):
    return f"\033[{code}m{s}\033[0m" if COLOR else s


def load_jobs():
    jobs = []
    for f in glob.glob(os.path.join(JOBS, "*", "state.json")):
        try:
            s = json.load(open(f))
        except Exception:
            continue
        d = os.path.dirname(f)
        out = s.get("output")
        if isinstance(out, dict):
            out = out.get("result") or json.dumps(out)
        out = (out or "").strip()
        if out.startswith("✓ "):
            out = out[2:]
        jobs.append({
            "id": os.path.basename(d),
            "dir": d,
            "state": s.get("state") or "?",
            "intent": " ".join((s.get("intent") or s.get("detail") or "").split()),
            "output": out,
            "updated": s.get("updatedAt") or "",
        })
    # Finished jobs first, latest finished on top; running ones below.
    jobs.sort(key=lambda j: j["updated"], reverse=True)
    jobs.sort(key=lambda j: j["state"] in RUNNING)
    return jobs


def is_finished(j):
    return j["state"] not in RUNNING


def read_marker(j):
    return os.path.join(j["dir"], ".read")


def set_badge(j, on):
    """Prefix '✓ ' to the job's summary text so the built-in Claude Code
    job list shows the read mark too. Removed on unread; naturally
    overwritten if the job produces new output."""
    f = os.path.join(j["dir"], "state.json")
    try:
        s = json.load(open(f))
    except Exception:
        return

    def mark(txt):
        has = txt.startswith("✓ ")
        if on and not has:
            return "✓ " + txt
        if not on and has:
            return txt[2:]
        return txt

    changed = False
    out = s.get("output")
    if isinstance(out, dict) and out.get("result"):
        out["result"], changed = mark(out["result"]), True
    elif isinstance(out, str) and out:
        s["output"], changed = mark(out), True
    if s.get("detail"):  # the built-in job list displays this field
        s["detail"], changed = mark(s["detail"]), True
    if not changed:
        return
    # The daemon reconciles by updatedAt freshness — a stale timestamp
    # means its cached (unmarked) copy wins and the edit never displays.
    # Bump by only 1ms so the job keeps its real finish-time sort order
    # instead of jumping to the top of the list when marked read.
    try:
        t = datetime.fromisoformat((s.get("updatedAt") or "").replace("Z", "+00:00")) \
            + timedelta(milliseconds=1)
    except ValueError:
        t = datetime.now(timezone.utc)
    stamp = t.strftime("%Y-%m-%dT%H:%M:%S.%f")[:-3] + "Z"
    s["updatedAt"] = stamp
    tmp = f + ".tmp"
    with open(tmp, "w") as fh:
        json.dump(s, fh, indent=2)
    os.replace(tmp, f)

    # The job list renders the last timeline event, so append one there too.
    tl = os.path.join(j["dir"], "timeline.jsonl")
    try:
        with open(tl) as fh:
            last = json.loads([l for l in fh if l.strip()][-1])
    except Exception:
        return
    if mark(last.get("detail") or "") == (last.get("detail") or ""):
        return  # already in the desired state
    last["detail"] = mark(last.get("detail") or "")
    last["at"] = stamp
    with open(tl, "a") as fh:
        fh.write(json.dumps(last, ensure_ascii=False) + "\n")


def updated_ts(j):
    try:
        return datetime.fromisoformat(j["updated"].replace("Z", "+00:00")).timestamp()
    except ValueError:
        return 0


def is_unread(j):
    """Finished, and not marked read since its last update."""
    if not is_finished(j):
        return False
    m = read_marker(j)
    return not os.path.exists(m) or os.path.getmtime(m) < updated_ts(j)


def resolve(prefix, jobs):
    hits = [j for j in jobs if j["id"].startswith(prefix)]
    if len(hits) == 1:
        return hits[0]
    print(f"{'ambiguous' if hits else 'no such'} job: {prefix}", file=sys.stderr)
    sys.exit(1)


def when(j):
    ts = updated_ts(j)
    if not ts:
        return "?"
    age = datetime.now(timezone.utc).timestamp() - ts
    if age < 3600:
        return f"{max(1, int(age // 60))}m ago"
    if age < 86400:
        return f"{int(age // 3600)}h ago"
    return datetime.fromtimestamp(ts).strftime("%b %d")


def show_list(jobs):
    if not jobs:
        print("no jobs")
        return
    for j in jobs:
        if not is_finished(j):
            mark, label = "·", "running"
        elif is_unread(j):
            mark, label = c("1;33", "●"), j["state"]
        else:
            mark, label = c("2", "✓"), j["state"]
        line = j["intent"] or "(no intent)"
        print(f"{mark} {j['id']}  {when(j):>7}  {label:<8} {line[:70]}")
        if is_unread(j) and j["output"]:
            print(f"    {c('2', j['output'][:100])}")
    running = sum(1 for j in jobs if not is_finished(j))
    unread = sum(1 for j in jobs if is_unread(j))
    print(f"\n{running} running · {unread} unread"
          + (" — 'agents show ID' to read, 'agents read ID' to check off" if unread else ""))


def main():
    args = sys.argv[1:]
    if args and args[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return
    jobs = load_jobs()

    if not args:
        show_list(jobs)
    elif args[0] == "unread" and len(args) == 1:
        show_list([j for j in jobs if is_unread(j)])
    elif args[0] == "unread":
        for p in args[1:]:
            j = resolve(p, jobs)
            if os.path.exists(read_marker(j)):
                os.remove(read_marker(j))
            set_badge(j, False)
            print(f"● {j['id']} marked unread")
    elif args[0] == "read":
        targets = ([j for j in jobs if is_finished(j)] if args[1:] == ["all"]
                   else [resolve(p, jobs) for p in args[1:]])
        if not targets:
            print("usage: agents read ID.. | all", file=sys.stderr)
            sys.exit(1)
        for j in targets:
            set_badge(j, True)  # before the marker: badge bumps updatedAt
            open(read_marker(j), "w").close()
            print(f"✓ {j['id']} read")
    elif args[0] == "show":
        if len(args) < 2:
            print("usage: agents show ID", file=sys.stderr)
            sys.exit(1)
        j = resolve(args[1], jobs)
        print(f"id:      {j['id']}")
        print(f"state:   {j['state']}   updated: {when(j)}")
        print(f"intent:  {j['intent']}")
        print(f"\n{j['output'] or '(no result text recorded)'}")
    else:
        print(__doc__.strip(), file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
